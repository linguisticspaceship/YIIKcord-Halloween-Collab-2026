[gd_scene format=3 uid="uid://c1mxogrtejnkw"]

[ext_resource type="FontFile" uid="uid://dslxb6suh2s8y" path="res://Fonts/bloodcrow.ttf" id="1_s74s8"]

[sub_resource type="GDScript" id="GDScript_s74s8"]
script/source = "extends Node3D

var threat = true

@onready var pullpart = $\"Model/PullyPart\"

func _ready() -> void:
	threat = Global.rorycat_threat

func _process(delta: float) -> void:
	if threat:
		$Label3D2.text = \"ON\"
		$Label3D2.modulate = \"#00a300\"
		pullpart.position.x = 0.123
		pullpart.rotation.z = deg_to_rad(-20.0)
	if !threat:
		$Label3D2.text = \"OFF\"
		$Label3D2.modulate = \"#ff0000\"
		pullpart.position.x = -0.089
		pullpart.rotation.z = deg_to_rad(20.0)

func _on_area_3d_input_event(camera: Node, event: InputEvent, event_position: Vector3, normal: Vector3, shape_idx: int) -> void:
	
	if event is InputEventMouseButton:
		if event.is_pressed():
			threat = !threat
			Global.rorycat_threat = threat
"

