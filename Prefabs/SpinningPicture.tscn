[sub_resource type="GDScript" id="GDScript_fxgfl"]
script/source = "extends Node3D

@onready var texture #= load(\"res://Sprites/Fanart/null.png\")
# Animated properties
var animated = false
var animation = null
var width = 0
var height = 0

var speed = 3

func _process(delta: float) -> void:
	if !animated:
		$SubViewport/Sprite2D.visible = true
		$SubViewport/AnimatedSprite2D.visible = false
		$SubViewport/Sprite2D.texture = texture
		$SubViewport.size = Vector2(width, height)
		#$Mesh.mesh.material.albedo_texture = texture
	if animated:
		$SubViewport/Sprite2D.visible = false
		$SubViewport/AnimatedSprite2D.visible = true
		$SubViewport/AnimatedSprite2D.animation = animation
		$SubViewport.size = Vector2(width, height)
		
	$Mesh.rotation.y += (speed * delta)
"

