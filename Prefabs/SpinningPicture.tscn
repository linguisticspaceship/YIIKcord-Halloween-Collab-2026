[sub_resource type="GDScript" id="GDScript_fxgfl"]
script/source = "extends Node3D

@onready var texture = load(\"res://Sprites/Fanart/alex eats mic.png\")

var speed = 3

func _process(delta: float) -> void:
	$Mesh.mesh.material.albedo_texture = texture
	$Mesh.rotation.y += (speed * delta)
"

