[sub_resource type="GDScript" id="GDScript_16w0o"]
script/source = "#@tool
extends Control

#@export_tool_button(\"Populate Container\",\"Callable\") var populate_container = _ready

var GalleryPicture = preload(\"res://Prefabs/GalleryPicture.tscn\")

func _ready() -> void:
	
	for x in $\"ScrollContainer/BoxContainer\".get_children():
		x.queue_free()
	
	for x in PictureData.list:
		
		var GalleryPicture_temp = GalleryPicture.instantiate()
		if Global.read(\"gallery_unlocked\",x) == false: # Pic locked
			GalleryPicture_temp.get_node(\"GalleryPicture\").texture = load(\"res://Sprites/Fanart/Null.png\") ### PLACEHOLDER
			GalleryPicture_temp.get_node(\"VBox/RichTextLabel\").text = \"?????\"
			GalleryPicture_temp.get_node(\"VBox/LinkButton\").queue_free()
		else: # Pic unlocked
			GalleryPicture_temp.get_node(\"GalleryPicture\").texture = load(PictureData.list[x].get(\"path\",\"res://Sprites/Fanart/Null.png\"))
			
			# HACKY FIX FOR WIDE IMAGES
			if GalleryPicture_temp.get_node(\"GalleryPicture\").texture != null:
				var texture_height = GalleryPicture_temp.get_node(\"GalleryPicture\").texture.get_height()
				match x:
					\"FleshSmoothie_1\":
						GalleryPicture_temp.get_node(\"GalleryPicture\").custom_maximum_size.y = texture_height / 4
			
			var author = PictureData.list[x][\"author\"]
			var link = PictureData.list[x].get(\"link\",\"\")
			GalleryPicture_temp.get_node(\"VBox/RichTextLabel\").text = \"Artist: \" + String(author)
			
			# SPECIAL CASE: CHCENO
			if PictureData.list[x][\"author\"] == \"chceno31\":
				GalleryPicture_temp.get_node(\"VBox/RichTextLabel\").text = \"Blabalbababala by chceno31\"
				GalleryPicture_temp.get_node(\"VBox/LinkButton\").text = \"Read Story\"
			
			if link == \"\":
				GalleryPicture_temp.get_node(\"VBox/LinkButton\").queue_free()
			if link != \"\":
				GalleryPicture_temp.get_node(\"VBox/LinkButton\").Link = link
		$\"ScrollContainer/BoxContainer\".add_child(GalleryPicture_temp)
"

