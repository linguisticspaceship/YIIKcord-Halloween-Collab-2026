[gd_scene format=3 uid="uid://dms5kdhkqb0qm"]

[sub_resource type="GDScript" id="GDScript_16w0o"]
script/source = "@tool
extends Control

@export_tool_button(\"Populate Container\",\"Callable\") var populate_container = _ready

var GalleryPicture = preload(\"res://Prefabs/GalleryPicture.tscn\")

func _ready() -> void:
	
	for x in $\"ScrollContainer/BoxContainer\".get_children():
		x.queue_free()
	
	for x in PictureData.list:
		
		var GalleryPicture_temp = GalleryPicture.instantiate()
		if Global.read(\"gallery_unlocked\",x) == false: # Pic locked
			GalleryPicture_temp.texture = load(\"res://Sprites/Fanart/Null.png\") ### PLACEHOLDER
		else: # Pic unlocked
			GalleryPicture_temp.texture = load(PictureData.list[x][\"path\"])
		$\"ScrollContainer/BoxContainer\".add_child(GalleryPicture_temp)
"

