script/source = "extends Control

var ButtonPrefab = load(\"res://Scenes/button_ui.tscn\")

var copiedSceneGoto = \"\"
var copiedQuitGame = \"\"
var copiedConfirmation = \"\"
var copiedConfirmationMessage = \"\"
var copiedKillNode = \"\"
var copiedEnablePlayer = \"\"

func _ready() -> void:
	var instance = ButtonPrefab.instantiate()
	instance.SceneGoto = copiedSceneGoto
	instance.QuitGame = copiedQuitGame
	instance.Confirmation = copiedConfirmation
	instance.ConfirmationMessage = copiedConfirmationMessage
	
	instance.KillNode = copiedKillNode
	instance.EnablePlayer = copiedEnablePlayer
"

