[sub_resource type="GDScript" id="GDScript_javds"]
script/source = "extends Node3D

var timer = 0.0
@export var timer_goal = 1.8
@export var scene = \"res://Scenes/MainMenu.tscn\"
var timer_has_met_goal = false

func _ready() -> void:
	Global.play_sound(\"game_over\", true, 0.0)
	Global.play_sound(\"static\", true, 0.0)

func _process(delta: float) -> void:
	if timer_has_met_goal:
		return
	
	timer = move_toward(timer, timer_goal, delta)
	
	if timer >= timer_goal:
		# Hacky
		timer_has_met_goal = true
		var button_prefab = load(\"res://Prefabs/button_ui.tscn\")
		var instance = button_prefab.instantiate()
		instance.visible = false
		if scene != \"\":
			instance.SceneGoto = scene
		add_child(instance)
		instance._on_pressed()
"

