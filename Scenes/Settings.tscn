[sub_resource type="GDScript" id="GDScript_fv8yg"]
script/source = "extends HSlider
# DEFAULT 0.01
func _ready() -> void:
	value = Global.read(\"settings\",\"sensitivity\")

func _on_drag_ended(_value_changed: bool) -> void:
	Global.setting_mouse_sensitivity = value
	Global.save(\"settings\",\"sensitivity\", value)
"

